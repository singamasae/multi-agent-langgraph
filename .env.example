# Copy to .env and fill in. Provide the API key(s) for whichever provider(s)
# your roles use (see *_PROVIDER below); every other setting is optional and
# falls back to the default shown.

# --- Provider API keys ---
# Only the key(s) for the provider(s) actually in use are required.
# With the default providers (all "google") only GOOGLE_API_KEY is needed.
GOOGLE_API_KEY="your_api_key_here"
# OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_BASE_URL=            # optional: OpenAI-compatible endpoint (Azure/proxy/local)

# --- Provider per role ("google" or "openai") ---
# SUPERVISOR_PROVIDER=google
# RESEARCHER_PROVIDER=google
# WRITER_PROVIDER=google

# --- Models (per role) ---
# Defaults are Gemini. When a role's provider is "openai", set its model to an
# OpenAI model, e.g. WRITER_PROVIDER=openai + WRITER_MODEL=gpt-4o-mini.
# SUPERVISOR_MODEL=gemini-flash-lite-latest
# RESEARCHER_MODEL=gemini-flash-lite-latest
# WRITER_MODEL=gemini-flash-lite-latest

# --- Sampling temperature (per role) ---
# SUPERVISOR_TEMPERATURE=0.0
# RESEARCHER_TEMPERATURE=0.0
# WRITER_TEMPERATURE=0.7

# --- Behaviour ---
# THINKING_BUDGET=0        # Gemini thinking tokens; 0 = off (forces text answers), -1 = dynamic
# SEARCH_MAX_RESULTS=3
# RECURSION_LIMIT=50

# --- HTTP server ---
# API_HOST=127.0.0.1
# API_PORT=8000

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # or "json" for structured logs

# --- Optional: zero-code tracing via LangSmith ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=...
