# Copy to .env and fill in. Only GOOGLE_API_KEY is required; every other
# setting is optional and falls back to the default shown.

# Required: Google Gemini API key.
GOOGLE_API_KEY="your_api_key_here"

# --- Models (per role) ---
# SUPERVISOR_MODEL=gemini-flash-lite-latest
# RESEARCHER_MODEL=gemini-flash-lite-latest
# WRITER_MODEL=gemini-flash-lite-latest

# --- Sampling temperature (per role) ---
# SUPERVISOR_TEMPERATURE=0.0
# RESEARCHER_TEMPERATURE=0.0
# WRITER_TEMPERATURE=0.7

# --- Behaviour ---
# THINKING_BUDGET=0        # Gemini thinking tokens; 0 = off (forces text answers), -1 = dynamic
# SEARCH_MAX_RESULTS=3
# RECURSION_LIMIT=50

# --- HTTP server ---
# API_HOST=127.0.0.1
# API_PORT=8000

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # or "json" for structured logs

# --- Optional: zero-code tracing via LangSmith ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=...
